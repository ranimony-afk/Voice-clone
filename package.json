{
  "name": "voiceforge",
  "private": true,
  "version": "2.0.0-alpha.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist-server/server.js && node -e \"require('node:fs').cpSync('dist', 'dist-server/dist', {recursive:true})\"",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist-server/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test test/**/*.test.ts",
    "test:inference": "cd services/omnivoice && python -m pytest tests -q",
    "e2e:smoke": "bash scripts/e2e_smoke.sh"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "description": "VoiceForge: multilingual AI voice platform (OmniVoice inference service + React studio). See FEATURE_MATRIX.md for what is REAL vs SIMULATED."
}