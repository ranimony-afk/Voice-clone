+
+v1Router.get('/voices/:id', (req, res) => {
+  const voice = customVoices.find(v => v.id === req.params.id);
+  if (!voice) {
+    return res.status(404).json({
+      error: { code: 'VOICE_NOT_FOUND', message: `Voice ID '${req.params.id}' does not exist.` },
+    });
+  }
+  res.json(voice);
