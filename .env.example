# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL connection string (e.g. postgresql://user:password@localhost:5432/voiceforge)
# When set, VoiceForge connects to PostgreSQL via Drizzle ORM; otherwise uses persistent local fallback.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voiceforge"

# Neural TTS is served by a separate long-lived Python/GPU worker.
# Never set the development stub flag in production.
OMNIVOICE_SERVICE_URL="http://localhost:8100"
VOICEFORGE_WORKER_API_KEY="replace-with-a-long-random-secret"
# Required for consent signing if those routes are ever enabled. Configure in a secret manager;
# use 32 random bytes encoded as 64 hexadecimal characters (e.g. openssl rand -hex 32).
# No runtime default exists; missing or malformed configuration fails closed.
# VOICEFORGE_CONSENT_SECRET=
# Provenance HMAC key. This is separate from the consent key; preserve raw-string HMAC input.
# Configure a random secret of at least 32 UTF-8 bytes via your secret manager; no runtime default.
# Generate a candidate with: openssl rand -hex 32
# VOICEFORGE_WATERMARK_KEY=
VOICEFORGE_ALLOW_DEV_STUB_ENGINE="false"
# Deprecated and ignored: simulated media routes stay fail-closed until their provider-free paths are verified.
# VOICEFORGE_ALLOW_SIMULATED_MEDIA="false"
OMNIVOICE_REQUEST_TIMEOUT_MS="300000"

# Vercel frontend API proxy target: hostname only, no scheme/path.
VOICEFORGE_API_HOST="api.example.invalid"
